# systemd/seem-agent.service
# TEMPLATE ONLY. Do not copy this file as-is.
# Replace SEEM_INSTALL_DIR and SEEM_USER, then install it yourself if you want a service.
# bootstrap.sh does not install systemd units.

[Unit]
Description=SEEM Sovereign Cognitive Microservice
After=network.target

[Service]
ExecStart=/usr/bin/python3 SEEM_INSTALL_DIR/seem.py daemon
WorkingDirectory=SEEM_INSTALL_DIR
Restart=always
RestartSec=5
User=SEEM_USER
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
